{
    "$schema": "https://v2-10-2.turborepo.dev/schema.json",
    "globalDependencies": ["tsconfig.json", "tsconfig.build.json", "eslint.config.ts", "prettier.config.ts"],
    "tasks": {
        "dev": {
            "cache": false,
            "persistent": true
        },
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**", ".output/**"]
        },
        "lint": {
            "outputs": []
        },
        "lint:fix": {
            "cache": false
        },
        "typecheck": {
            "dependsOn": ["^build"],
            "outputs": []
        },
        "test": {
            "outputs": []
        },
        "test:cov": {
            "outputs": ["coverage/**"]
        },
        "generate": {
            "dependsOn": ["^build"],
            "outputs": ["src/generated/**", "../../openapi/**"]
        }
    }
}
