// TSConfig for tooling/config files (ESLint, Vitest) that run in Node via
// transpilation rather than `nest build`. Bundler resolution lets these files
// import the shared root `eslint.config.ts` with its explicit `.ts` extension
// (required by jiti at runtime) without tripping TS5097.
{
    "extends": "./tsconfig.json",
    "include": ["vitest.config.*", "eslint.config.*"],
    "compilerOptions": {
        "module": "preserve",
        "moduleResolution": "bundler",
        "types": ["node"],
        // `composite` (required for project references) implies the project is
        // build-able, so emit must stay enabled. Nothing actually builds this
        // project — it exists purely to give the editor bundler-mode type-checking
        // for the config files — so the emit target is never produced.
        "composite": true,
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo"
    }
}
