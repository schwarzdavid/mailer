{
    "extends": "./tsconfig.json",
    "compilerOptions": {
        "rootDir": "./src",
        "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.build.tsbuildinfo"
    },
    "exclude": [
        "node_modules",
        "test",
        "dist",
        "**/*spec.ts",
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.*.ts",
        "src/migrate.ts",
        "src/migrations/**"
    ]
}
